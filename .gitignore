# Secrets and API keys - never commit these
.env

# Database - contains personal cognitive data
memory.db
memory.db-wal
memory.db-shm

# Logs - operational noise, not source content
logs/

# Cache - regenerated automatically
cache/

# Python cache
__pycache__/
*.pyc
*.pyo

# macOS metadata
.DS_Store

# Backups — managed separately
backups/
*.zip
*.tar.gz

# Generated session files — build artifacts, regenerated nightly by generate_session_prompt.py
# Edit cowork_instructions.md to change standing instructions (that file IS committed)
cowork_context.md
START_HERE.md

# Generated memory files — contain personal cognitive data, rebuilt each session by pipeline scripts
# Never commit these to a shared repo
recent_memory.md
deep_memory.md

# Session transcripts — personal conversation data
# The conversations/ folder is created by setup.sh on fresh install; contents are never committed
conversations/

# Debug output — raw Qwen extraction JSON files, one per pipeline run (large, personal)
debug/*.json

# Research content — fetched transcripts and personal research docs
research/transcripts/*.txt
research/outside_architecture_sessions/

# Personal folder — user-specific docs, one-off scripts, private notes
# Move anything Bobby-specific here; it will never be tracked by git
personal/

# User configuration — contains personal paths and email
# Committed as .ember_config.template; generated by setup.sh on install
.ember_config

# Machine-generated session files — personal memory data, rebuilt each session
ember_engine_context.md
curator_report.md
current_intent.txt


# pytest runtime artifacts
pytest-cache-files-*
.pytest_cache/

# Claude Code local settings — contains machine-specific absolute paths
.claude/

# Google Drive FUSE filesystem artifacts
.fuse_hidden*

# Scout digest outputs — generated by generate_scout_digest.py, personal research data
scout_digest_latest.md
research/digests/
